# ------------------------------------------------------------------
# TalentLedger GH - required environment variables
# Copy to .env.local and fill in values. NEVER commit real secrets.
# ------------------------------------------------------------------

# Hosted Supabase project. Get these from:
#   Supabase Dashboard -> your project -> Settings -> API (or "API Keys")
# URL:  https://<project-ref>.supabase.co   (no brackets!)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# Paystack (GHS payments). Get from https://dashboard.paystack.com -> Settings -> API Keys
# Leave unset / placeholder to simulate payments (auto-marks paid).
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Public URL of the deployed app (used as Paystack callback destination).
NEXT_PUBLIC_APP_URL=https://talentledger-gh.vercel.app

# Admin dashboard password. Single shared secret for the judges portal,
# backed by a signed HttpOnly session cookie. Use a LONG random value
# (16+ characters). Rotate it and update Vercel when changed.
ADMIN_PASSWORD=change-me-to-a-long-random-password-at-least-16-chars